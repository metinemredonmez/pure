# Sertifika alırken kullanılan geçici yapılandırma: yalnızca 80 numaralı port ve ACME doğrulaması.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 503;
    }
}
