# Olentia Pure — Backend Environment
# Copy this to .env and fill in your values

# DATABASE
DATABASE_URL="postgresql://olentia:olentia_dev_2024@localhost:5434/olentia?schema=public"

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6380

# JWT
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# GOOGLE OAUTH
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# GOOGLE PLACES API — gerçek Google yorumlarını çekmek için
# Boş bırakılırsa /public/google-reviews mock veri döner (siteyi kırmaz)
# Place ID: https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# APPLE OAUTH
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=http://localhost:4000/api/auth/apple/callback

# MINIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_ACCESS_KEY=olentia_minio
MINIO_SECRET_KEY=olentia_minio_secret
MINIO_BUCKET=olentia-media
MINIO_USE_SSL=false

# RABBITMQ
RABBITMQ_URL=amqp://olentia:olentia_rabbit@localhost:5673

# EMAIL
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=hello@olentia.com

# IYZICO
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# PUSH NOTIFICATIONS
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# APP
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
API_PREFIX=api
THROTTLE_TTL=60
THROTTLE_LIMIT=100
