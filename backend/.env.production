# Olentia Pure — Backend Production Environment
# PM2 ile çalışır, Docker kullanılmaz

# DATABASE (prod PostgreSQL — varsayılan port)
DATABASE_URL="postgresql://olentia:PROD_DB_PASSWORD@localhost:5432/olentia?schema=public"

# REDIS (varsayılan port)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (prod için güçlü secret)
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_MIN_64_CHARS
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# GOOGLE OAUTH
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.olentia.com/api/auth/google/callback

# APPLE OAUTH
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=https://api.olentia.com/api/auth/apple/callback

# MINIO / S3 (prod — MinIO veya AWS S3)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=olentia-media
MINIO_USE_SSL=false

# RABBITMQ (varsayılan port)
RABBITMQ_URL=amqp://olentia:PROD_RABBIT_PASSWORD@localhost:5672

# EMAIL (prod SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=hello@olentia.com

# PAYMENT - PAYTR
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_BASE_URL=https://www.paytr.com

# PAYMENT - IYZICO
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://api.iyzipay.com

# GOOGLE PAY
GOOGLE_PAY_MERCHANT_ID=
GOOGLE_PAY_ENVIRONMENT=PRODUCTION

# APPLE PAY
APPLE_PAY_MERCHANT_ID=
APPLE_PAY_DOMAIN_VERIFICATION=

# PUSH NOTIFICATIONS
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# GOOGLE MAPS
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_GEOCODING=true

# OPENAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
OPENAI_TTS_MODEL=tts-1
OPENAI_WHISPER_MODEL=whisper-1

# APP
PORT=4000
NODE_ENV=production
CORS_ORIGINS=https://olentia.com,https://admin.olentia.com,https://www.olentia.com
API_PREFIX=api
THROTTLE_TTL=60
THROTTLE_LIMIT=60
